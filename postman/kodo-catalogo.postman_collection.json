{
  "info": {
    "name": "KodoApp API - Catálogo de Vehículos Nuevos",
    "description": "Colección para probar el CRUD completo del recurso 'catalogo' de KodoApp API (arquitectura por capas). Correr la API en http://localhost:4000 con `npm run dev`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    }
  ],
  "item": [
    {
      "name": "1. Listar vehículos del catálogo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('La respuesta es un arreglo de vehículos', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/catalogo",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "catalogo"
          ]
        }
      }
    },
    {
      "name": "2. Obtener vehículo por ID (id: 1)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Devuelve el vehículo solicitado', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('id', 1);",
              "  pm.expect(body).to.have.property('modelo');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/catalogo/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "catalogo",
            "1"
          ]
        }
      }
    },
    {
      "name": "3. Crear nuevo vehículo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Devuelve el vehículo creado con id', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('id');",
              "  pm.expect(body).to.have.property('modelo', 'CX-90');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"modelo\": \"CX-90\",\n  \"version\": \"3.3 Turbo Premium\",\n  \"anio\": 2026,\n  \"precio_usd\": 57990.00,\n  \"stock\": 4,\n  \"combustible\": \"gasolina\",\n  \"transmision\": \"automatica\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/catalogo",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "catalogo"
          ]
        }
      }
    },
    {
      "name": "4. Actualizar vehículo por ID (id: 1)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Refleja los datos actualizados', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('precioUsd', 18490);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"modelo\": \"Mazda2\",\n  \"version\": \"1.5 Core MT\",\n  \"anio\": 2026,\n  \"precio_usd\": 18490.00,\n  \"stock\": 8,\n  \"combustible\": \"gasolina\",\n  \"transmision\": \"mecanica\",\n  \"destacado\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/catalogo/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "catalogo",
            "1"
          ]
        }
      }
    },
    {
      "name": "5. Eliminar vehículo (id: 4)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code es 204', function () {",
              "  pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/catalogo/4",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "catalogo",
            "4"
          ]
        }
      }
    }
  ]
}
