# Copia este archivo como .env y reemplaza cada texto por tu valor real
#   Windows: copy .env.example .env    ·    Mac/Linux: cp .env.example .env
# El archivo .env NO se sube a GitHub (está en .gitignore). Este archivo no lleva credenciales.

# API
PORT=puerto_de_la_api_por_ejemplo_4000
CORS_ORIGIN=origen_permitido_por_ejemplo_http://localhost:3000

# Conexión a MySQL desde Node (docker-compose.yml usa estos mismos valores para crear la base)
# Si la API corre en tu máquina, MySQL del contenedor se ve en localhost y en el puerto publicado
DB_HOST=host_de_mysql_localhost_si_la_api_corre_fuera_de_docker
DB_PORT=puerto_publicado_por_docker_compose_por_ejemplo_3307
DB_USER=usuario_de_mysql_que_usara_la_api
DB_PASSWORD=contraseña_del_usuario_de_mysql
DB_NAME=nombre_de_la_base_por_ejemplo_kodo_db

# Solo para el contenedor de MySQL
MYSQL_ROOT_PASSWORD=contraseña_del_usuario_root_de_mysql
